font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 8%

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none

background-opacity = 0.85

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

copy-on-select = clipboard
keybind = ctrl+v=paste_from_clipboard
confirm-close-surface = false

# Cool Fog — CapsuleOS night-bridge default. The wallpaper picker writes a
# matching palette to the cache file below, which overrides everything here.
background = #0a0e16
foreground = #c3cddb
cursor-color = #5b9cdc
selection-background = #2a3547
selection-foreground = #f2f6fb
palette = 0=#1b0c0b
palette = 1=#d76742
palette = 2=#499331
palette = 3=#a77b23
palette = 4=#bb7127
palette = 5=#db546a
palette = 6=#788b1d
palette = 7=#bfbab5
palette = 8=#76706b
palette = 9=#dd7f5f
palette = 10=#55ab39
palette = 11=#c28f29
palette = 12=#d78c42
palette = 13=#e27789
palette = 14=#8ca122
palette = 15=#f8f7f7

config-file = ?~/.cache/capsuleos/ghostty-colors
