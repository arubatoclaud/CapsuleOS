font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 8%

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none

background-opacity = 0.85

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

copy-on-select = clipboard
keybind = ctrl+v=paste_from_clipboard
confirm-close-surface = false

# Cool Fog — PillOS night-bridge default. The wallpaper picker writes a
# matching palette to the cache file below, which overrides everything here.
background = #0a0e16
foreground = #c3cddb
cursor-color = #ffb454
selection-background = #2a3547
selection-foreground = #f2f6fb
palette = 0=#1a2230
palette = 1=#d4707c
palette = 2=#7fb3a3
palette = 3=#d9b26a
palette = 4=#8fa9c9
palette = 5=#a68fc9
palette = 6=#7fb3c3
palette = 7=#c3cddb
palette = 8=#3a4658
palette = 9=#e08a96
palette = 10=#99ccb8
palette = 11=#ecc985
palette = 12=#a9c3e0
palette = 13=#c0aade
palette = 14=#99ccd9
palette = 15=#f2f6fb

config-file = ?~/.cache/pillos/ghostty-colors
